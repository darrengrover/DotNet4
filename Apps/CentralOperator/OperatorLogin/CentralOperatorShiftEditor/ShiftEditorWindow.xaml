<Window x:Class="CentralOperatorShiftEditor.ShiftEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift Management Editor" Height="700" Width="1200">
    <TabControl>
        <!-- Shifts Tab -->
        <TabItem Header="Shifts">
            <DockPanel>
                <ToolBarTray DockPanel.Dock="Top">
                    <ToolBar>
                        <Button Content="Add Shift" Click="BtnAddShift_Click"/>
                        <Button Content="Delete Shift" Click="BtnDeleteShift_Click"/>
                        <Separator/>
                        <Button Content="Save" Click="BtnSaveShifts_Click"/>
                        <Button Content="Refresh" Click="BtnRefreshShifts_Click"/>
                    </ToolBar>
                </ToolBarTray>

                <DataGrid x:Name="dgShifts" 
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Shift ID" Binding="{Binding ShiftID}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Shift Name" Binding="{Binding ShiftName}" Width="150"/>
                        <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime, StringFormat=hh\\:mm}" Width="100"/>
                        <DataGridTextColumn Header="End Time" Binding="{Binding EndTime, StringFormat=hh\\:mm}" Width="100"/>
                        <DataGridTextColumn Header="Delta - (min)" Binding="{Binding DeltaMinus}" Width="100"/>
                        <DataGridTextColumn Header="Delta + (min)" Binding="{Binding DeltaPlus}" Width="100"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Machine Assignments Tab -->
        <TabItem Header="Machine Assignments">
            <DockPanel>
                <ToolBarTray DockPanel.Dock="Top">
                    <ToolBar>
                        <Button Content="Add Assignment" Click="BtnAddAssignment_Click"/>
                        <Button Content="Delete Assignment" Click="BtnDeleteAssignment_Click"/>
                        <Separator/>
                        <Button Content="Save" Click="BtnSaveAssignments_Click"/>
                        <Button Content="Refresh" Click="BtnRefreshAssignments_Click"/>
                    </ToolBar>
                </ToolBarTray>

                <DataGrid x:Name="dgAssignments" 
                          AutoGenerateColumns="False"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Assignment ID" Binding="{Binding AssignmentID}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="Shift ID" Binding="{Binding ShiftID}" Width="80"/>
                        <DataGridTextColumn Header="Machine RecNum" Binding="{Binding MachineRecNum}" Width="120"/>
                        <DataGridTextColumn Header="Machine ID" Binding="{Binding MachineIdJensen}" Width="120"/>
                        <DataGridComboBoxColumn Header="Day of Week" 
                                                SelectedValueBinding="{Binding DayOfWeek}"
                                                Width="120"/>
                        <DataGridTextColumn Header="Day Name" Binding="{Binding DayOfWeekName}" Width="100"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate, StringFormat=G}" IsReadOnly="True" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Shift Settings Tab -->
        <TabItem Header="Shift Settings">
            <DockPanel>
                <ToolBarTray DockPanel.Dock="Top">
                    <ToolBar>
                        <Button Content="Save" Click="BtnSaveShiftSettings_Click"/>
                        <Button Content="Refresh" Click="BtnRefreshShiftSettings_Click"/>
                    </ToolBar>
                </ToolBarTray>

                <DataGrid x:Name="dgShiftSettings" 
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Setting ID" Binding="{Binding SettingID}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Setting Name" Binding="{Binding SettingName}" IsReadOnly="True" Width="200"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding SettingValue}" Width="200"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Detail}" Width="400"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Operator Settings Tab -->
        <TabItem Header="Operator Settings">
            <DockPanel>
                <ToolBarTray DockPanel.Dock="Top">
                    <ToolBar>
                        <Button Content="Add Setting" Click="BtnAddOperatorSetting_Click"/>
                        <Button Content="Delete Setting" Click="BtnDeleteOperatorSetting_Click"/>
                        <Separator/>
                        <Button Content="Save" Click="BtnSaveOperatorSettings_Click"/>
                        <Button Content="Refresh" Click="BtnRefreshOperatorSettings_Click"/>
                    </ToolBar>
                </ToolBarTray>

                <DataGrid x:Name="dgOperatorSettings" 
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Setting ID" Binding="{Binding OperatorSettingID}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="Operator RecNum" Binding="{Binding OperatorRecNum}" Width="150"/>
                        <DataGridCheckBoxColumn Header="Can Replace Operator" Binding="{Binding CanReplaceOperator}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>